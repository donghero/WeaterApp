{
  "expo": {
    "name": "weater",
    "slug": "weater",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [["expo-splash-screen", {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }], ["expo-location", {
      "locationWhenInUsePermission": "Allow Weather to use your location to show local weather."
    }]]
  }
}
